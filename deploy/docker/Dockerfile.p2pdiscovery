FROM golang:1.21-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /out/p2pdiscovery ./cmd/p2pdiscovery

FROM alpine:3.20
RUN adduser -D -H p2pdiscovery
COPY --from=build /out/p2pdiscovery /usr/local/bin/p2pdiscovery
USER p2pdiscovery
EXPOSE 4001/tcp
ENV P2PDISCOVERY_LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001
ENV P2PDISCOVERY_NAT_PORT_MAP=true
ENV P2PDISCOVERY_RELAY_SERVICE=true
ENTRYPOINT ["/usr/local/bin/p2pdiscovery"]
