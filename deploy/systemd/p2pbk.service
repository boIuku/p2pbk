[Unit]
Description=p2pbk background service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/p2pbk --config /etc/p2pbk/config.json daemon
Restart=on-failure
RestartSec=5s
User=p2pbk
Group=p2pbk
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
