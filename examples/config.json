{
  "node": {
    "data_dir": "~/.p2pbk",
    "identity": "identity.age",
    "display_name": ""
  },
  "storage": {
    "store_dir": "store",
    "cache_dir": "cache",
    "cache_size_bytes": 1073741824,
    "offer_bytes": 10000000000
  },
  "network": {
    "listen_addrs": [
      "/ip4/0.0.0.0/tcp/0",
      "/ip4/0.0.0.0/udp/0/quic-v1"
    ],
    "bootstrap_peers": [],
    "protocol_id": "/p2pbk/1.0.0",
    "min_peers": 3
  },
  "backup": {
    "data_shards": 6,
    "parity_shards": 3,
    "roots": [],
    "max_bytes": 10000000000,
    "schedule": "daily",
    "retention": "30d",
    "initial_full": true,
    "incremental": true
  },
  "trust": {
    "challenge_interval": "1h0m0s",
    "reputation_window": "720h0m0s",
    "challenge_max_length": 65536,
    "identity_passphrase": ""
  }
}
